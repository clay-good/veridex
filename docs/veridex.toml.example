# Example veridex.toml — copy to your project root (or point at it with `--config`).
#
# Veridex auto-discovers a `veridex.toml` in the current directory. Every key is optional; the
# defaults below match Veridex's built-in behavior. Unknown keys and check ids that name no real
# check are rejected with an error (run `veridex checks` for the catalog), so a typo can't silently
# change what runs. The effective configuration is recorded in every verdict.

# Failure threshold for the `veridex check` exit code: "error" (default) exits 20 only on error
# findings; "warning" also fails on warnings. The `--fail-on` flag overrides this.
fail_on = "error"

# Minimum trust score (0–100) required to pass; a lower score fails the run regardless of finding
# severities. Omit to disable the gate. The `--min-score` flag overrides this.
# min_score = 80

# Run only these categories. Omit to run all. Valid: structural, temporal, statistical, semantic,
# video, provenance, autonomy.
# categories = ["structural", "temporal"]

# Run only these specific checks (by id). Omit to run all selected categories.
# only_checks = ["temporal.clock-skew", "structural.episode-boundary"]

# Disable specific checks by id, even within a selected category.
disabled_checks = []

# Override a check's default severity. Keys are check ids; values are info | warning | error.
# For example, treat cross-stream clock skew as a warning rather than an error:
# [severity_overrides]
# "temporal.clock-skew" = "warning"

# Numeric tolerances for the checks that take one. Each is optional and falls back to the default
# shown. Raise a threshold for a rig with a known offset (e.g. a camera that lags the arm by 80 ms).
# [tolerances]
# clock_skew_ms = 50      # TEMPORAL.CLOCK_SKEW: max cross-stream duration drift
# start_offset_ms = 50    # TEMPORAL.START_OFFSET: max shared-clock start offset
# end_offset_ms = 50      # TEMPORAL.END_OFFSET: max shared-clock end offset
# rate_deviation = 0.10   # TEMPORAL.RATE: allowed relative rate deviation (0.10 = 10%)
# gap_factor = 3.0        # TEMPORAL.GAP: an interval this many times the expected one is a gap
# jitter_cv = 0.5         # TEMPORAL.JITTER: max coefficient of variation (std/mean) of intervals
# episode_duration_factor = 10.0  # TEMPORAL.EPISODE_DURATION_OUTLIER: multiple-of-median past which an episode duration is an outlier (must be > 1.0)
# saturation_fraction = 0.50      # STATISTICAL.SATURATED: fraction of samples exactly pinned at one extreme to flag (in (0.0, 1.0])
# saturation_min_samples = 20     # STATISTICAL.SATURATED: minimum recomputed samples before the check applies
# outlier_z = 10.0                # STATISTICAL.OUTLIER: standard deviations from the mean at which a value is flagged (must be > 1.0)
# sequence_drop_fraction = 0.05   # AUTONOMY.SEQUENCE_COMPLETE: tolerated fraction of a rig sensor's implied frames that may be missing (in [0.0, 1.0))
# ego_max_speed_mps = 100.0       # AUTONOMY.EGO_POSE_CONTINUITY: maximum plausible ego speed; a step implying more is a teleport
# near_duplicate_fraction = 0.80  # STRUCTURAL.NEAR_DUPLICATE_EPISODE: shared fraction of frames at which two episodes are near-duplicates (in (0.0, 1.0])

# ---------------------------------------------------------------------------
# The environment layer
# ---------------------------------------------------------------------------
#
# Precedence is: built-in defaults, then this file, then the environment, then command-line flags.
# Every key above has one `VERIDEX_` twin, so a container or CI job can configure a run without
# writing a file:
#
#   VERIDEX_CONFIG=path/to/veridex.toml   # which file to read (--config still wins)
#   VERIDEX_FAIL_ON=warning
#   VERIDEX_MIN_SCORE=80
#   VERIDEX_CATEGORIES=structural,temporal
#   VERIDEX_ONLY_CHECKS=temporal.clock-skew
#   VERIDEX_DISABLED_CHECKS=semantic.task-quality
#   VERIDEX_SEVERITY_OVERRIDES=temporal.clock-skew=warning,temporal.gaps=info
#   VERIDEX_TOLERANCE_CLOCK_SKEW_MS=20    # one per tolerance key, upper-cased
#   VERIDEX_PROFILE=world-model-ready     # as --profile (the flag still wins)
#
# Values are validated exactly as they are here: an out-of-range tolerance, an unknown category, or
# a `VERIDEX_TOLERANCE_*` name that matches no key is an error, never a silently ignored setting.
# An empty value is refused too — in a shell script that is almost always an unset variable, and
# reading it as an instruction would deselect everything.
#
# `veridex check --print-config` prints the resolved result with the layer each value came from.
