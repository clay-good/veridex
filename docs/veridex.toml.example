# Example veridex.toml — copy to your project root (or point at it with `--config`).
#
# Veridex auto-discovers a `veridex.toml` in the current directory. Every key is optional; the
# defaults below match Veridex's built-in behavior. Unknown keys and check ids that name no real
# check are rejected with an error (run `veridex checks` for the catalog), so a typo can't silently
# change what runs. The effective configuration is recorded in every verdict.

# Failure threshold for the `veridex check` exit code: "error" (default) exits 20 only on error
# findings; "warning" also fails on warnings. The `--fail-on` flag overrides this.
fail_on = "error"

# Minimum trust score (0–100) required to pass; a lower score fails the run regardless of finding
# severities. Omit to disable the gate. The `--min-score` flag overrides this.
# min_score = 80

# Run only these categories. Omit to run all. Valid: structural, temporal, statistical, semantic,
# provenance.
# categories = ["structural", "temporal"]

# Run only these specific checks (by id). Omit to run all selected categories.
# only_checks = ["temporal.clock-skew", "structural.episode-boundary"]

# Disable specific checks by id, even within a selected category.
disabled_checks = []

# Override a check's default severity. Keys are check ids; values are info | warning | error.
# For example, treat cross-stream clock skew as a warning rather than an error:
# [severity_overrides]
# "temporal.clock-skew" = "warning"

# Numeric tolerances for the checks that take one. Each is optional and falls back to the default
# shown. Raise a threshold for a rig with a known offset (e.g. a camera that lags the arm by 80 ms).
# [tolerances]
# clock_skew_ms = 50      # TEMPORAL.CLOCK_SKEW: max cross-stream duration drift
# start_offset_ms = 50    # TEMPORAL.START_OFFSET: max shared-clock start offset
# end_offset_ms = 50      # TEMPORAL.END_OFFSET: max shared-clock end offset
# rate_deviation = 0.10   # TEMPORAL.RATE: allowed relative rate deviation (0.10 = 10%)
# gap_factor = 3.0        # TEMPORAL.GAP: an interval this many times the expected one is a gap
# jitter_cv = 0.5         # TEMPORAL.JITTER: max coefficient of variation (std/mean) of intervals
